generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

model User {
  id            String        @id @default(cuid())
  fullName      String
  email         String        @unique
  password      String
  image         String?
  role          Role          @default(STUDENT)
  provider      AuthProvider  @default(CREDENTIALS)

  emailVerified Boolean       @default(false)
  isActive      Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Future Relations
  // enrollments
  // progress
  // aiChats
  // quizAttempts
  // subscriptions
}